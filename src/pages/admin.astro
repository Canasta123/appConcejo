---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Panel de Administración - Concejo Municipal de Chía" description="Panel de gestión interna de prensa e información institucional.">
  <div class="admin-container">
    
    <!-- PANTALLA DE INICIO DE SESIÓN -->
    <div class="login-box" id="login-box">
      <div class="login-header">
        <div class="login-badge">🏛️ Panel Interno</div>
        <h2>Acceso Administrativo</h2>
        <p>Inicie sesión con sus credenciales de prensa/administración para gestionar contenido.</p>
      </div>

      <form class="login-form" id="login-form">
        <div class="form-group">
          <label for="admin-user">Usuario</label>
          <input type="text" id="admin-user" placeholder="Ej: admin" required />
        </div>

        <div class="form-group">
          <label for="admin-pass">Contraseña</label>
          <input type="password" id="admin-pass" placeholder="••••••••" required />
        </div>

        <div class="alert-box error" id="login-error" style="display:none;"></div>

        <button type="submit" class="btn-login" id="btn-login">
          <span>Iniciar Sesión</span>
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </form>
    </div>

    <!-- PANEL PRINCIPAL (DASHBOARD) -->
    <div class="dashboard-box" id="dashboard-box" style="display:none;">
      <!-- Header Admin -->
      <header class="dash-header">
        <div class="user-info">
          <div class="avatar-circle">👤</div>
          <div>
            <h2 class="user-name" id="dash-user-name">Administrador</h2>
            <span class="user-role" id="dash-user-role">Prensa & Contenido</span>
          </div>
        </div>
        <button class="btn-logout" id="btn-logout">
          <span>Cerrar Sesión</span>
        </button>
      </header>

      <!-- Tabs de Gestión -->
      <nav class="dash-tabs">
        <button class="dash-tab active" data-tab="agenda">🗓️ Agenda</button>
        <button class="dash-tab" data-tab="noticias">📰 Noticias</button>
        <button class="dash-tab" data-tab="documentos">📄 Documentos</button>
      </nav>

      <!-- TAB 1: GESTIÓN DE AGENDA -->
      <section class="tab-content active" id="tab-agenda">
        <div class="tab-header-row">
          <div>
            <h3>Agenda de Sesiones y Eventos</h3>
            <p>Agregue o modifique sesiones plenarias y comisiones.</p>
          </div>
          <button class="btn-primary-action" id="btn-new-agenda">
            <span>➕ Nuevo Evento</span>
          </button>
        </div>

        <div class="data-table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Fecha y Hora</th>
                <th>Título del Evento</th>
                <th>YouTube Live</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="agenda-table-body">
              <tr><td colspan="4" class="loading-td">Cargando eventos...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- TAB 2: GESTIÓN DE NOTICIAS -->
      <section class="tab-content" id="tab-noticias">
        <div class="tab-header-row">
          <div>
            <h3>Noticias Institucionales</h3>
            <p>Publicación y edición de boletines y comunicados.</p>
          </div>
          <button class="btn-primary-action" id="btn-new-noticia">
            <span>➕ Nueva Noticia</span>
          </button>
        </div>

        <div class="data-table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Título</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="noticias-table-body">
              <tr><td colspan="4" class="loading-td">Cargando noticias...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- TAB 3: GESTIÓN DE DOCUMENTOS -->
      <section class="tab-content" id="tab-documentos">
        <div class="tab-header-row">
          <div>
            <h3>Gaceta y Documentos Oficiales</h3>
            <p>Registro de Acuerdos, Resoluciones, Actas y Circulares.</p>
          </div>
          <button class="btn-primary-action" id="btn-new-doc">
            <span>➕ Nuevo Documento</span>
          </button>
        </div>

        <div class="data-table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Nombre del Documento</th>
                <th>Categoría</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="docs-table-body">
              <tr><td colspan="4" class="loading-td">Cargando documentos...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>

    <!-- MODAL FORMULARIO GENERICO DE GESTION -->
    <div class="admin-modal-backdrop" id="admin-modal" style="display:none;">
      <div class="admin-modal-dialog">
        <header class="modal-header">
          <h3 id="modal-form-title">Formulario de Gestión</h3>
          <button class="modal-close" id="admin-modal-close">&times;</button>
        </header>

        <form id="admin-modal-form" class="admin-form">
          <div class="modal-form-fields" id="modal-form-fields">
            <!-- Campos dinámicos JS -->
          </div>

          <div class="alert-box error" id="form-error" style="display:none;"></div>
          <div class="alert-box success" id="form-success" style="display:none;"></div>

          <footer class="modal-footer">
            <button type="button" class="btn-cancel" id="btn-form-cancel">Cancelar</button>
            <button type="submit" class="btn-save" id="btn-form-save">Guardar Cambios</button>
          </footer>
        </form>
      </div>
    </div>

  </div>

  <script>
    import { API_BASE_URL } from '../utils/api.js';

    let currentAdmin = null;

    // Verificar sesión al cargar
    async function checkSession() {
      try {
        const res = await fetch(`${API_BASE_URL}/admin/verificar_sesion.php`);
        const data = await res.json();
        if (data.autenticado && data.admin) {
          currentAdmin = data.admin;
          showDashboard();
        } else {
          showLogin();
        }
      } catch (e) {
        showLogin();
      }
    }

    function showLogin() {
      document.getElementById('login-box').style.display = 'block';
      document.getElementById('dashboard-box').style.display = 'none';
    }

    function showDashboard() {
      document.getElementById('login-box').style.display = 'none';
      document.getElementById('dashboard-box').style.display = 'block';
      
      if (currentAdmin) {
        document.getElementById('dash-user-name').textContent = currentAdmin.usuario || 'Administrador';
        document.getElementById('dash-user-role').textContent = `Rol: ${currentAdmin.rol || 'Editor'}`;
      }

      loadAgendaAdmin();
      loadNoticiasAdmin();
      loadDocsAdmin();
    }

    // Login Form Submit
    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const user = document.getElementById('admin-user').value.trim();
      const pass = document.getElementById('admin-pass').value.trim();
      const errorBox = document.getElementById('login-error');
      
      errorBox.style.display = 'none';

      try {
        const res = await fetch(`${API_BASE_URL}/admin/login.php`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ usuario: user, password: pass })
        });
        
        let data = {};
        try {
          data = await res.json();
        } catch (e) {
          throw new Error(`Respuesta no válida del servidor (${res.status}). Verifique la instalación de la API PHP.`);
        }

        if (res.ok && data.admin) {
          currentAdmin = data.admin;
          showDashboard();
        } else {
          errorBox.textContent = data.error || `Credenciales incorrectas (HTTP ${res.status}).`;
          errorBox.style.display = 'block';
        }
      } catch (err) {
        errorBox.textContent = err.message || 'Error de conexión con el servidor. Verifique su internet o cPanel.';
        errorBox.style.display = 'block';
      }
    });

    // Logout
    document.getElementById('btn-logout')?.addEventListener('click', async () => {
      try {
        await fetch(`${API_BASE_URL}/admin/logout.php`, { method: 'POST' });
      } catch (e) {}
      currentAdmin = null;
      showLogin();
    });

    // Tab Navigation
    const tabs = document.querySelectorAll('.dash-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        
        tab.classList.add('active');
        const targetId = `tab-${tab.getAttribute('data-tab')}`;
        document.getElementById(targetId)?.classList.add('active');
      });
    });

    /* --- CARGA Y ACCIONES DE AGENDA --- */

    async function loadAgendaAdmin() {
      const tbody = document.getElementById('agenda-table-body');
      if (!tbody) return;

      try {
        const res = await fetch(`${API_BASE_URL}/public/get_agenda.php`);
        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="empty-td">No hay eventos en la agenda.</td></tr>';
          return;
        }

        tbody.innerHTML = data.map(e => `
          <tr>
            <td><strong>${e.fecha_hora}</strong></td>
            <td>${e.titulo}</td>
            <td>${e.link_yt ? `<a href="${e.link_yt}" target="_blank" class="link-yt">▶️ Ver Link</a>` : '<span class="text-muted">No asignado</span>'}</td>
            <td class="actions-td">
              <button class="btn-sm btn-edit" onclick="window.editEvento(${e.id_evento}, '${encodeURIComponent(JSON.stringify(e))}')">✏️ Editar</button>
              <button class="btn-sm btn-delete" onclick="window.deleteEvento(${e.id_evento})">🗑️ Eliminar</button>
            </td>
          </tr>
        `).join('');
      } catch (err) {
        tbody.innerHTML = '<tr><td colspan="4" class="error-td">Error al cargar la agenda.</td></tr>';
      }
    }

    // Modal Form Handler
    const modal = document.getElementById('admin-modal');
    const modalTitle = document.getElementById('modal-form-title');
    const modalFields = document.getElementById('modal-form-fields');
    const formError = document.getElementById('form-error');
    const formSuccess = document.getElementById('form-success');
    let currentSaveHandler = null;

    function openAdminModal(title, htmlFields, onSave) {
      modalTitle.textContent = title;
      modalFields.innerHTML = htmlFields;
      formError.style.display = 'none';
      formSuccess.style.display = 'none';
      currentSaveHandler = onSave;
      modal.style.display = 'flex';
    }

    function closeAdminModal() {
      modal.style.display = 'none';
    }

    document.getElementById('admin-modal-close')?.addEventListener('click', closeAdminModal);
    document.getElementById('btn-form-cancel')?.addEventListener('click', closeAdminModal);

    document.getElementById('admin-modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (currentSaveHandler) {
        formError.style.display = 'none';
        formSuccess.style.display = 'none';
        await currentSaveHandler();
      }
    });

    // Nuevo Evento
    document.getElementById('btn-new-agenda')?.addEventListener('click', () => {
      const now = new Date();
      const nowISO = now.toISOString().slice(0, 16);

      openAdminModal('➕ Crear Nuevo Evento en Agenda', `
        <div class="form-group">
          <label>Título del Evento / Sesión</label>
          <input type="text" id="f-titulo" placeholder="Ej: Sesión Plenaria Ordinaria No. 12" required />
        </div>
        <div class="form-group">
          <label>Fecha y Hora</label>
          <input type="datetime-local" id="f-fecha" value="${nowISO}" required />
        </div>
        <div class="form-group">
          <label>Enlace YouTube Live (Opcional)</label>
          <input type="url" id="f-link" placeholder="https://www.youtube.com/watch?v=..." />
        </div>
      `, async () => {
        const titulo = document.getElementById('f-titulo').value.trim();
        const fecha_hora = document.getElementById('f-fecha').value.replace('T', ' ') + ':00';
        const link_yt = document.getElementById('f-link').value.trim() || null;

        const res = await fetch(`${API_BASE_URL}/admin/crear_evento.php`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ titulo, fecha_hora, link_yt })
        });
        const data = await res.json();
        if (res.ok) {
          formSuccess.textContent = '¡Evento guardado exitosamente!';
          formSuccess.style.display = 'block';
          setTimeout(() => { closeAdminModal(); loadAgendaAdmin(); }, 1000);
        } else {
          formError.textContent = data.error || 'No se pudo guardar el evento.';
          formError.style.display = 'block';
        }
      });
    });

    window.editEvento = function(id, encodedJson) {
      const evento = JSON.parse(decodeURIComponent(encodedJson));
      const fechaVal = evento.fecha_hora ? evento.fecha_hora.replace(' ', 'T').slice(0, 16) : '';

      openAdminModal('✏️ Editar Evento de Agenda', `
        <div class="form-group">
          <label>Título del Evento / Sesión</label>
          <input type="text" id="f-titulo" value="${evento.titulo || ''}" required />
        </div>
        <div class="form-group">
          <label>Fecha y Hora</label>
          <input type="datetime-local" id="f-fecha" value="${fechaVal}" required />
        </div>
        <div class="form-group">
          <label>Enlace YouTube Live (Opcional)</label>
          <input type="url" id="f-link" value="${evento.link_yt || ''}" />
        </div>
      `, async () => {
        const titulo = document.getElementById('f-titulo').value.trim();
        const fecha_hora = document.getElementById('f-fecha').value.replace('T', ' ') + ':00';
        const link_yt = document.getElementById('f-link').value.trim() || null;

        const res = await fetch(`${API_BASE_URL}/admin/editar_evento.php?id=${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ titulo, fecha_hora, link_yt })
        });
        const data = await res.json();
        if (res.ok) {
          formSuccess.textContent = '¡Evento actualizado!';
          formSuccess.style.display = 'block';
          setTimeout(() => { closeAdminModal(); loadAgendaAdmin(); }, 1000);
        } else {
          formError.textContent = data.error || 'No se pudo actualizar.';
          formError.style.display = 'block';
        }
      });
    };

    window.deleteEvento = async function(id) {
      if (!confirm('¿Está seguro de eliminar este evento de la agenda?')) return;
      try {
        const res = await fetch(`${API_BASE_URL}/admin/eliminar_evento.php?id=${id}`, { method: 'DELETE' });
        if (res.ok) {
          loadAgendaAdmin();
        } else {
          alert('No se pudo eliminar el evento.');
        }
      } catch (e) {
        alert('Error de conexión.');
      }
    };

    /* --- CARGA Y ACCIONES DE NOTICIAS --- */

    async function loadNoticiasAdmin() {
      const tbody = document.getElementById('noticias-table-body');
      if (!tbody) return;

      try {
        const res = await fetch(`${API_BASE_URL}/public/get_noticias.php`);
        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="empty-td">No hay noticias registradas.</td></tr>';
          return;
        }

        tbody.innerHTML = data.map(n => `
          <tr>
            <td>${n.fecha_pub || ''}</td>
            <td><strong>${n.titulo}</strong></td>
            <td><span class="badge-status ${n.estado === 'activo' ? 'active' : 'inactive'}">${n.estado || 'activo'}</span></td>
            <td class="actions-td">
              <button class="btn-sm btn-edit" onclick="window.editNoticia(${n.id_noticia}, '${encodeURIComponent(JSON.stringify(n))}')">✏️ Editar</button>
              <button class="btn-sm btn-delete" onclick="window.deleteNoticia(${n.id_noticia})">🗑️ Eliminar</button>
            </td>
          </tr>
        `).join('');
      } catch (err) {
        tbody.innerHTML = '<tr><td colspan="4" class="error-td">Error al cargar noticias.</td></tr>';
      }
    }

    document.getElementById('btn-new-noticia')?.addEventListener('click', () => {
      openAdminModal('➕ Publicar Nueva Noticia', `
        <div class="form-group">
          <label>Título de la Noticia</label>
          <input type="text" id="f-titulo" placeholder="Ej: Aprobado histórico presupuesto..." required />
        </div>
        <div class="form-group">
          <label>URL de Imagen Destacada / Portada</label>
          <input type="url" id="f-imagen" placeholder="https://concejodechia.gov.co/imagen.jpg" />
        </div>
        <div class="form-group">
          <label>Estado</label>
          <select id="f-estado">
            <option value="activo" selected>Activo (Visible)</option>
            <option value="inactivo">Inactivo (Oculto)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Contenido de la Noticia (Texto / HTML)</label>
          <textarea id="f-contenido" rows="6" placeholder="Escriba el texto del comunicado o noticia..." required></textarea>
        </div>
      `, async () => {
        const titulo = document.getElementById('f-titulo').value.trim();
        const url_imagen = document.getElementById('f-imagen').value.trim() || null;
        const estado = document.getElementById('f-estado').value;
        const contenido = document.getElementById('f-contenido').value.trim();

        const res = await fetch(`${API_BASE_URL}/admin/crear_noticia.php`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ titulo, url_imagen, estado, contenido })
        });
        const data = await res.json();
        if (res.ok) {
          formSuccess.textContent = '¡Noticia publicada!';
          formSuccess.style.display = 'block';
          setTimeout(() => { closeAdminModal(); loadNoticiasAdmin(); }, 1000);
        } else {
          formError.textContent = data.error || 'No se pudo publicar la noticia.';
          formError.style.display = 'block';
        }
      });
    });

    window.editNoticia = function(id, encodedJson) {
      const n = JSON.parse(decodeURIComponent(encodedJson));

      openAdminModal('✏️ Editar Noticia', `
        <div class="form-group">
          <label>Título</label>
          <input type="text" id="f-titulo" value="${n.titulo || ''}" required />
        </div>
        <div class="form-group">
          <label>URL de Imagen Destacada</label>
          <input type="url" id="f-imagen" value="${n.url_imagen || ''}" />
        </div>
        <div class="form-group">
          <label>Estado</label>
          <select id="f-estado">
            <option value="activo" ${n.estado === 'activo' ? 'selected' : ''}>Activo</option>
            <option value="inactivo" ${n.estado === 'inactivo' ? 'selected' : ''}>Inactivo</option>
          </select>
        </div>
        <div class="form-group">
          <label>Contenido</label>
          <textarea id="f-contenido" rows="6" required>${n.contenido || ''}</textarea>
        </div>
      `, async () => {
        const titulo = document.getElementById('f-titulo').value.trim();
        const url_imagen = document.getElementById('f-imagen').value.trim() || null;
        const estado = document.getElementById('f-estado').value;
        const contenido = document.getElementById('f-contenido').value.trim();

        const res = await fetch(`${API_BASE_URL}/admin/editar_noticia.php?id=${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ titulo, url_imagen, estado, contenido })
        });
        const data = await res.json();
        if (res.ok) {
          formSuccess.textContent = '¡Noticia actualizada!';
          formSuccess.style.display = 'block';
          setTimeout(() => { closeAdminModal(); loadNoticiasAdmin(); }, 1000);
        } else {
          formError.textContent = data.error || 'No se pudo actualizar.';
          formError.style.display = 'block';
        }
      });
    };

    window.deleteNoticia = async function(id) {
      if (!confirm('¿Está seguro de eliminar esta noticia?')) return;
      try {
        const res = await fetch(`${API_BASE_URL}/admin/eliminar_noticia.php?id=${id}`, { method: 'DELETE' });
        if (res.ok) {
          loadNoticiasAdmin();
        } else {
          alert('No se pudo eliminar la noticia.');
        }
      } catch (e) {
        alert('Error de conexión.');
      }
    };

    /* --- CARGA Y ACCIONES DE DOCUMENTOS --- */

    async function loadDocsAdmin() {
      const tbody = document.getElementById('docs-table-body');
      if (!tbody) return;

      try {
        const res = await fetch(`${API_BASE_URL}/public/get_documentos.php`);
        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="empty-td">No hay documentos cargados.</td></tr>';
          return;
        }

        tbody.innerHTML = data.map(d => `
          <tr>
            <td>${d.fecha_sub || ''}</td>
            <td><strong>${d.nombre}</strong></td>
            <td><span class="chip-doc">${d.categoria || 'Acuerdo'}</span></td>
            <td class="actions-td">
              <button class="btn-sm btn-edit" onclick="window.editDoc(${d.id_doc}, '${encodeURIComponent(JSON.stringify(d))}')">✏️ Editar</button>
              <button class="btn-sm btn-delete" onclick="window.deleteDoc(${d.id_doc})">🗑️ Eliminar</button>
            </td>
          </tr>
        `).join('');
      } catch (err) {
        tbody.innerHTML = '<tr><td colspan="4" class="error-td">Error al cargar documentos.</td></tr>';
      }
    }

    document.getElementById('btn-new-doc')?.addEventListener('click', () => {
      const today = new Date().toISOString().slice(0, 10);

      openAdminModal('➕ Subir / Registrar Documento Oficial', `
        <div class="form-group">
          <label>Nombre del Documento</label>
          <input type="text" id="f-nombre" placeholder="Ej: Acuerdo No. 15 de 2026..." required />
        </div>
        <div class="form-group">
          <label>Categoría</label>
          <select id="f-categoria">
            <option value="Acuerdo">Acuerdo</option>
            <option value="Resolución">Resolución</option>
            <option value="Acta">Acta</option>
            <option value="Circular">Circular</option>
          </select>
        </div>
        <div class="form-group">
          <label>URL del Archivo PDF</label>
          <input type="text" id="f-pdf" placeholder="/documentos/acuerdo_015_2026.pdf" required />
        </div>
        <div class="form-group">
          <label>Fecha de Publicación</label>
          <input type="date" id="f-fecha" value="${today}" required />
        </div>
      `, async () => {
        const nombre = document.getElementById('f-nombre').value.trim();
        const categoria = document.getElementById('f-categoria').value;
        const url_pdf = document.getElementById('f-pdf').value.trim();
        const fecha_sub = document.getElementById('f-fecha').value;

        const res = await fetch(`${API_BASE_URL}/admin/crear_documento.php`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, categoria, url_pdf, fecha_sub })
        });
        const data = await res.json();
        if (res.ok) {
          formSuccess.textContent = '¡Documento registrado!';
          formSuccess.style.display = 'block';
          setTimeout(() => { closeAdminModal(); loadDocsAdmin(); }, 1000);
        } else {
          formError.textContent = data.error || 'No se pudo guardar el documento.';
          formError.style.display = 'block';
        }
      });
    });

    window.editDoc = function(id, encodedJson) {
      const d = JSON.parse(decodeURIComponent(encodedJson));

      openAdminModal('✏️ Editar Documento Oficial', `
        <div class="form-group">
          <label>Nombre del Documento</label>
          <input type="text" id="f-nombre" value="${d.nombre || ''}" required />
        </div>
        <div class="form-group">
          <label>Categoría</label>
          <select id="f-categoria">
            <option value="Acuerdo" ${d.categoria === 'Acuerdo' ? 'selected' : ''}>Acuerdo</option>
            <option value="Resolución" ${d.categoria === 'Resolución' ? 'selected' : ''}>Resolución</option>
            <option value="Acta" ${d.categoria === 'Acta' ? 'selected' : ''}>Acta</option>
            <option value="Circular" ${d.categoria === 'Circular' ? 'selected' : ''}>Circular</option>
          </select>
        </div>
        <div class="form-group">
          <label>URL del Archivo PDF</label>
          <input type="text" id="f-pdf" value="${d.url_pdf || ''}" required />
        </div>
      `, async () => {
        const nombre = document.getElementById('f-nombre').value.trim();
        const categoria = document.getElementById('f-categoria').value;
        const url_pdf = document.getElementById('f-pdf').value.trim();

        const res = await fetch(`${API_BASE_URL}/admin/editar_documento.php?id=${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, categoria, url_pdf })
        });
        const data = await res.json();
        if (res.ok) {
          formSuccess.textContent = '¡Documento actualizado!';
          formSuccess.style.display = 'block';
          setTimeout(() => { closeAdminModal(); loadDocsAdmin(); }, 1000);
        } else {
          formError.textContent = data.error || 'No se pudo actualizar.';
          formError.style.display = 'block';
        }
      });
    };

    window.deleteDoc = async function(id) {
      if (!confirm('¿Está seguro de eliminar este documento?')) return;
      try {
        const res = await fetch(`${API_BASE_URL}/admin/eliminar_documento.php?id=${id}`, { method: 'DELETE' });
        if (res.ok) {
          loadDocsAdmin();
        } else {
          alert('No se pudo eliminar el documento.');
        }
      } catch (e) {
        alert('Error de conexión.');
      }
    };

    document.addEventListener('DOMContentLoaded', checkSession);
  </script>
</MainLayout>

