---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Gaceta y Documentos - Concejo Municipal de Chía" description="Consulte la gaceta y los documentos oficiales del Concejo Municipal de Chía.">
  <div class="page-container">
    <header class="page-header">
      <h1 class="page-title">Gaceta y Documentos Oficiales</h1>
      <p class="page-subtitle">Consulte acuerdos, resoluciones, actas y circulares expedidas por la corporación.</p>
    </header>

    <!-- Barra de Búsqueda -->
    <div class="search-container">
      <div class="search-bar">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <input type="text" id="docs-search-input" placeholder="Buscar documento por nombre..." />
      </div>
    </div>

    <!-- Chips de Filtro -->
    <div class="filter-chips">
      <button class="chip active" data-filter="Todos">Todos</button>
      <button class="chip" data-filter="Acuerdo">Acuerdo</button>
      <button class="chip" data-filter="Resolución">Resolución</button>
      <button class="chip" data-filter="Acta">Acta</button>
      <button class="chip" data-filter="Circular">Circular</button>
    </div>

    <!-- Lista de Documentos -->
    <div class="docs-list" id="docs-grid">
      <!-- Loading Skeleton -->
      <div class="doc-card-skeleton">
        <div class="sk-icon"></div>
        <div class="sk-details">
          <div class="sk-line title"></div>
          <div class="sk-line short"></div>
        </div>
      </div>
      <div class="doc-card-skeleton">
        <div class="sk-icon"></div>
        <div class="sk-details">
          <div class="sk-line title"></div>
          <div class="sk-line short"></div>
        </div>
      </div>
      <div class="doc-card-skeleton">
        <div class="sk-icon"></div>
        <div class="sk-details">
          <div class="sk-line title"></div>
          <div class="sk-line short"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { getDocumentos } from '../utils/api.js';

    let globalDocumentos = [];

    function formatFecha(fechaStr) {
      if (!fechaStr) return '';
      const d = new Date(fechaStr);
      if (isNaN(d.getTime())) return fechaStr;
      const yyyy = d.getFullYear();
      const mm = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      return `${yyyy}-${mm}-${dd}`;
    }

    function renderDocumentos(documentos) {
      const container = document.getElementById('docs-grid');
      if (!container) return;

      if (!documentos || documentos.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color:var(--text-muted); margin-bottom: 12px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <p class="empty-msg">No se encontraron documentos con los criterios de búsqueda.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = documentos.map((doc) => {
        const fechaFormat = formatFecha(doc.fecha_sub);
        
        return `
          <article class="doc-card">
            <div class="doc-icon-col">
              <svg class="pdf-icon" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 9h1.5m1.5 0H15m-4.5 3h3m-3 3h3"></path>
              </svg>
            </div>
            <div class="doc-info-col">
              <div class="doc-meta-row">
                <span class="doc-badge">${doc.categoria || 'Documento'}</span>
                <span class="doc-date">🗓️ ${fechaFormat}</span>
              </div>
              <h3 class="doc-title">${doc.nombre}</h3>
            </div>
            <div class="doc-action-col">
              <a href="${doc.url_pdf}" target="_blank" rel="noopener" class="btn-download" aria-label="Ver Documento">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
              </a>
            </div>
          </article>
        `;
      }).join('');
    }

    async function init() {
      const documentos = await getDocumentos();
      globalDocumentos = documentos || [];
      renderDocumentos(globalDocumentos);

      // Búsqueda
      const input = document.getElementById('docs-search-input');
      if (input) {
        input.addEventListener('input', (e) => {
          filtrarDocumentos();
        });
      }

      // Filtros
      const chips = document.querySelectorAll('.filter-chips .chip');
      chips.forEach(chip => {
        chip.addEventListener('click', () => {
          chips.forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          filtrarDocumentos();
        });
      });
    }

    function filtrarDocumentos() {
      const query = (document.getElementById('docs-search-input').value || '').toLowerCase();
      const activeChip = document.querySelector('.filter-chips .chip.active');
      const filter = activeChip ? activeChip.getAttribute('data-filter') : 'Todos';

      let filtrados = globalDocumentos;

      if (filter !== 'Todos') {
        filtrados = filtrados.filter(d => (d.categoria || '').toLowerCase() === filter.toLowerCase());
      }

      if (query.trim() !== '') {
        filtrados = filtrados.filter(d => (d.nombre || '').toLowerCase().includes(query));
      }

      renderDocumentos(filtrados);
    }

    document.addEventListener('DOMContentLoaded', init);
  </script>
</MainLayout>

<style>
  :root {
    --primary: #3359A4;
    --primary-dark: #2A4783;
    --secondary: #009741;
    --bg: #F8F9FA;
    --surface: #FFFFFF;
    --text-main: #1F2937;
    --text-muted: #6B7280;
    --border: #E5E7EB;
    --pdf-color: #E30D21;
  }

  .page-container {
    padding: 16px;
    padding-bottom: 90px;
    background-color: var(--bg);
    min-height: 100vh;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .page-header {
    margin-bottom: 20px;
  }

  .page-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.6rem;
    color: var(--primary-dark);
    margin: 0 0 6px 0;
  }

  .page-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* Búsqueda */
  .search-container {
    margin-bottom: 16px;
  }

  .search-bar {
    display: flex;
    align-items: center;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 10px 16px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  }

  .search-bar svg {
    color: var(--text-muted);
    margin-right: 10px;
    flex-shrink: 0;
  }

  .search-bar input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 0.95rem;
    color: var(--text-main);
    background: transparent;
  }

  /* Chips */
  .filter-chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 12px;
    margin-bottom: 16px;
    -webkit-overflow-scrolling: touch;
  }

  .chip {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.2s;
  }

  .chip.active {
    background-color: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  /* Lista de Documentos */
  .docs-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .doc-card {
    background-color: var(--surface);
    border-radius: 12px;
    border: 1px solid var(--border);
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .doc-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(51, 89, 164, 0.1);
  }

  .doc-icon-col {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(227, 13, 33, 0.08);
    width: 48px;
    height: 48px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .pdf-icon {
    color: var(--pdf-color);
  }

  .doc-info-col {
    flex: 1;
    min-width: 0;
  }

  .doc-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .doc-badge {
    background-color: rgba(0, 151, 65, 0.1);
    color: var(--secondary);
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .doc-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .doc-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .doc-action-col {
    flex-shrink: 0;
  }

  .btn-download {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: rgba(51, 89, 164, 0.08);
    color: var(--primary);
    border-radius: 50%;
    transition: background-color 0.2s, color 0.2s;
  }

  .btn-download:hover {
    background-color: var(--primary);
    color: white;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    background-color: var(--surface);
    border-radius: 12px;
    border: 1px dashed var(--border);
  }

  .empty-msg {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  /* Skeleton Loading */
  .doc-card-skeleton {
    background: var(--surface);
    border-radius: 12px;
    border: 1px solid var(--border);
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sk-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: linear-gradient(90deg, #e0e0e0 25%, #f0f0f0 50%, #e0e0e0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    flex-shrink: 0;
  }

  .sk-details {
    flex: 1;
  }

  .sk-line {
    height: 14px;
    border-radius: 6px;
    background: linear-gradient(90deg, #e0e0e0 25%, #f0f0f0 50%, #e0e0e0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    margin-bottom: 8px;
  }

  .sk-line.title {
    width: 80%;
    height: 18px;
  }

  .sk-line.short {
    width: 40%;
    margin-bottom: 0;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>
